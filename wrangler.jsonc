{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aiubcs-api",
  "main": "worker/index.ts",
  "compatibility_date": "2024-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aiubcs-db",
      "database_id": "f6dab8b9-2e57-4b27-8a5c-ae4ef8053825"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "aiubcs-materials"
    }
  ]
}
